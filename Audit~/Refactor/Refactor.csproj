<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);$(AdditionalDefineConstants)</DefineConstants>
    <DefineConstants Condition="'$(RefactorApi)' == 'true'">$(DefineConstants);REFACTOR_API</DefineConstants>
    <SourceRoot Condition="'$(SourceRoot)' == ''">../..</SourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SourceRoot)/Runtime/**/*.cs" />
    <Compile Include="../UnityStubs.cs" />
    <Compile Include="RuntimeBenchmarks.cs" />
  </ItemGroup>
</Project>
