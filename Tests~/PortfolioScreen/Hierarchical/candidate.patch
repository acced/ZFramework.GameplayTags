+        // Only the local storage can change before callbacks when there is no parent.
+        // Validate every index first: legacy overflow/copy states can contain an
+        // out-of-array explicit index, and snapshots throw before any mutation.
+        private bool CanReadExplicitTagsDirectly(TagStorage source)
+        {
+            if (source == null || m_ParentContainer != null ||
+                ReferenceEquals(source, m_UnderlyingContainer.Indices.Storage))
+                return false;
+
+            int count = source.ExplicitCount;
+            if ((uint)count > (uint)source.ExplicitIndices.Length)
+                return false;
+            int entryCapacity = source.Entries.Length;
+            for (int i = 0; i < count; i++)
+                if ((uint)source.ExplicitIndices[i] >= (uint)entryCapacity)
+                    return false;
+            return true;
+        }
+
