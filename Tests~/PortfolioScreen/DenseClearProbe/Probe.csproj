<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><LangVersion>9.0</LangVersion><Nullable>disable</Nullable><ImplicitUsings>disable</ImplicitUsings><EnableDefaultCompileItems>false</EnableDefaultCompileItems></PropertyGroup>
  <Target Name="RequirePinnedRuntime" BeforeTargets="BeforeBuild"><Error Condition="'$(RuntimeRoot)' == ''" Text="Pass the materialized pinned Runtime directory through RuntimeRoot." /></Target>
  <ItemGroup><Compile Include="$(RuntimeRoot)/**/*.cs" Exclude="$(RuntimeRoot)/GameObjectGameplayTagContainer.cs" /><Compile Include="Harness/Probe.cs" /></ItemGroup>
</Project>
