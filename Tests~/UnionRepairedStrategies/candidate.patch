+        private void QueueIntrusiveContribution(int id, int amount, uint pendingMask, int linkShift,
+            ref int head, ref int tail, ref int queued)
+        {
+            int index = Find(id);
+            if (index < 0)
+                index = Insert(id);
+            if (((uint)Entries[index].ExplicitCount & pendingMask) == 0)
+            {
