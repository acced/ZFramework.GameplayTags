+                    Entries[previous].ExplicitCount = unchecked((int)(
+                        ((uint)Entries[previous].ExplicitCount & (pendingMask | 1u)) |
+                        ((uint)encoded << linkShift)));
+                }
+                tail = encoded;
+                queued++;
+            }
+            Entries[index].ExplicitCount = unchecked(Entries[index].ExplicitCount + (amount << 1));
+        }
