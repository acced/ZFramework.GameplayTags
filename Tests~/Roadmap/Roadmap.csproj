<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable><LangVersion>9.0</LangVersion><GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RuntimePath Condition="'$(RuntimePath)' == ''">../../Runtime</RuntimePath>
    <DefineConstants Condition="'$(PhaseApis)' != 'false'">$(DefineConstants);PHASE_APIS</DefineConstants>
  </PropertyGroup>
  <ItemGroup><Compile Include="$(RuntimePath)/*.cs"/><Compile Include="Program.cs"/><Compile Include="UnityStubs.cs"/></ItemGroup>
</Project>
