<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(MonoTarget)' != 'true'">net8.0</TargetFramework>
    <TargetFramework Condition="'$(MonoTarget)' == 'true'">net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RuntimeRoot Condition="'$(RuntimeRoot)' == ''">../../Runtime</RuntimeRoot>
    <StartupObject Condition="'$(ColdProbe)' != 'true'">FinalConsolidationProbe</StartupObject>
    <StartupObject Condition="'$(CoreTests)' == 'true'">Program</StartupObject>
    <StartupObject Condition="'$(ColdProbe)' == 'true'">FinalConsolidationCold</StartupObject>
    <TieredCompilation>false</TieredCompilation>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RuntimeRoot)/**/*.cs" Exclude="$(RuntimeRoot)/GameObjectGameplayTagContainer.cs" />
    <Compile Include="Program.cs;Cold.cs" Condition="'$(CoreTests)' != 'true'" />
    <Compile Include="../Program.cs;../FixtureRegistration.cs" Condition="'$(CoreTests)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(MonoTarget)' == 'true'">
    <Reference Include="System.Runtime.Serialization" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
  </ItemGroup>
</Project>
