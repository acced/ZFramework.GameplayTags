<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(MonoTarget)' != 'true'">net8.0</TargetFramework>
    <TargetFramework Condition="'$(MonoTarget)' == 'true'">net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <TieredCompilation>false</TieredCompilation>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RuntimeRoot)/**/*.cs" Exclude="$(RuntimeRoot)/GameObjectGameplayTagContainer.cs" />
    <Compile Include="$(HarnessFile)" />
  </ItemGroup>
  <ItemGroup Condition="'$(MonoTarget)' == 'true'">
    <Reference Include="System.Runtime.Serialization" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
  </ItemGroup>
  <Target Name="RecordResolvedInputs" AfterTargets="CoreCompile">
    <WriteLinesToFile File="$(InputManifest)" Lines="@(Compile->'compile|%(FullPath)');@(ReferencePath->'reference|%(FullPath)')" Overwrite="true" />
  </Target>
</Project>
